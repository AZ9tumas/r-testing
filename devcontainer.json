{
  "name": "R with ggplot2 and animint2",
  "image": "rocker/tidyverse:latest",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/r-rstudio:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [8787, 8000, 8080],
  "portsAttributes": {
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "animint2 Preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "Rscript -e \"install.packages(c('ggplot2', 'animint2'), repos='https://cloud.r-project.org')\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "GitHub.copilot"
      ]
    }
  }
}
